{
  "manifest_version": 3,
  "name": "Matte AMOLED Black Theme",
  "version": "1.0.0",
  "description": "True matte AMOLED pitch-black theme for Google Chrome omnibox, tabs, toolbar, and window frame.",
  "theme": {
    "colors": {
      "frame": [0, 0, 0],
      "frame_inactive": [0, 0, 0],
      "frame_incognito": [0, 0, 0],
      "frame_incognito_inactive": [0, 0, 0],
      "toolbar": [0, 0, 0],
      "tab_text": [255, 255, 255],
      "tab_background_text": [180, 180, 180],
      "bookmark_text": [255, 255, 255],
      "omnibox_background": [0, 0, 0],
      "omnibox_text": [255, 255, 255],
      "ntp_background": [0, 0, 0],
      "ntp_text": [255, 255, 255],
      "ntp_link": [255, 255, 255],
      "button_background": [0, 0, 0, 1]
    },
    "tints": {
      "buttons": [0, 0, 1]
    }
  }
}

{
  "manifest_version": 3,
  "name": "Monochrome — Minimalist New Tab",
  "version": "1.0.0",
  "description": "Minimal, monochromatic developer-grade new tab with interactive particle clock and quick favorites.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "theme": {
    "colors": {
      "frame": [0, 0, 0],
      "frame_inactive": [0, 0, 0],
      "frame_incognito": [0, 0, 0],
      "frame_incognito_inactive": [0, 0, 0],
      "toolbar": [0, 0, 0],
      "tab_text": [255, 255, 255],
      "tab_background_text": [180, 180, 180],
      "bookmark_text": [255, 255, 255],
      "omnibox_background": [0, 0, 0],
      "omnibox_text": [255, 255, 255],
      "ntp_background": [0, 0, 0],
      "ntp_text": [255, 255, 255],
      "ntp_link": [255, 255, 255],
      "button_background": [0, 0, 0, 1]
    },
    "tints": {
      "buttons": [0, 0, 1]
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
